lab_field_options = Options: { $list }.
lab_field_range = Accepted range: { $min } to { $max }.
lab_field_range_int = Accepted range: { $min } to { $max }, whole numbers.
lab_err_int = Use an integer between { $min } and { $max }.
lab_err_range = Use a value between { $min } and { $max }.
lab_gen_failed = Could not generate the floor
lab_valid = Valid
