lab_v_v3_doors = Two doors of room #{ $a } are too close together.
lab_v_v4_alphabet = Corridor #{ $a } uses a direction that is not allowed.
lab_v_v4_turn = Corridor #{ $a } has a { $b }° bend, which is not allowed.
lab_v_v4_segment = A segment of corridor #{ $a } is too short ({ $b } px).
